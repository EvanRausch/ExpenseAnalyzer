# Copy this file to .env and fill in your real keys.
# .env is gitignored — never commit real credentials.

# Google Gemini API key
# Get one at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Google Places API key (New Places API must be enabled in Google Cloud Console)
# Get one at: https://console.cloud.google.com/apis/credentials
# Required API: "Places API (New)"
GOOGLE_PLACES_API_KEY=

# Plaid keys, for importing transactions straight from the bank
# Get them at: https://dashboard.plaid.com/developers/keys
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_SANDBOX_SECRET=
# "sandbox" = practice mode with a fake bank, "production" = your real bank
PLAID_ENV=sandbox

# Server (python -m server.cli serve). All optional when running it on your own computer.
# Database address; a local file data/server.db is used when empty
DATABASE_URL=
# Key that encrypts bank access tokens; required with any database other than the local file
EXPENSE_SECRET_KEY=
# The iPhone app's bundle id, which Sign in with Apple tokens must be issued for
APPLE_BUNDLE_ID=EvanRL.ExpenseAnalyzer
# This server's public address ending in /plaid/webhook, where Plaid announces new transactions
PLAID_WEBHOOK_URL=
